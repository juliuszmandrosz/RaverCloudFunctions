rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        function isAuthenticated() {
            return request.auth != null;
        }

        function isUser() {
            return isAuthenticated() && hasUserClaim();
        }

        function isPartner() {
            return isAuthenticated() && hasPartnerClaim();
        }

        function isSelector() {
            return isAuthenticated() && hasSelectorClaim();
        }

        function hasUserClaim() {
            return 'isUser' in request.auth.token && request.auth.token.isUser == true;
        }


        function hasPartnerClaim() {
            return 'isPartner' in request.auth.token && request.auth.token.isPartner == true;
        }

        function hasSelectorClaim() {
            return 'isSelector' in request.auth.token && request.auth.token.isSelector == true;
        }

        function getPartner() {
            return get(/databases/$(database)/documents/partners/$(request.auth.uid));
        }

        function getSelector() {
            return get(/databases/$(database)/documents/selectors/$(request.auth.uid));
        }

        function isPartnerFromClub(clubId) {
            return clubId == getPartner().data.clubId;
        }

        function isSelectorFromClub(clubId) {
            return clubId == getSelector().data.clubId;
        }

        function isRequestFromCurrentAccount(accountId) {
            return request.auth.uid == accountId;
        }

        function isNullOrEmpty(fieldName) {
            return !(fieldName in request.resource.data) || getLength(fieldName) == 0;
        }

        function isNotEmptyString(fieldName) {
            return request.resource.data[fieldName] is string && getLength(fieldName) > 0;
        }

        function isNonNegativeNumber(fieldName) {
            return request.resource.data[fieldName] is number && request.resource.data[fieldName] >= 0;
        }

        function getLength(fieldName) {
            return request.resource.data[fieldName].size();
        }


        match /availableFilters/{filters} {
            allow read: if isAuthenticated();
            allow write: if false;
        }

        match /clubs/{clubId} {
            allow read: if isAuthenticated();
            allow write: if isPartner() && isPartnerFromClub(clubId);

            match /appliedDiscounts/{discountId} {
                allow read, create: if isPartner() && isPartnerFromClub(clubId);
            }

            match /eventCosts/{eventId} {
                allow read, create: if isPartner() && isPartnerFromClub(clubId);
            }

            match /eventReview/{eventId} {
                allow read, create: if isPartner() && isPartnerFromClub(clubId);
            }

            match /eventTickets/{eventId} {
                allow read: if isAuthenticated();
                allow create: if isPartner() && isPartnerFromClub(clubId);
                allow update: if isPartner()
                                 && isPartnerFromClub(clubId)
                                 && request.resource.data.ticketSales == resource.data.ticketSales;
            }

            match /reviews/{reviewId} {
                function getUserRate() {
                    return request.resource.data.userRate;
                }

                function getUserTicket() {
                    return get(/databases/$(database)/documents/users/$(request.auth.uid)/tickets/$(request.resource.data.ticketId)).data;
                }


                allow read: if isAuthenticated();
                allow create: if isUser()
                                 && getUserRate() >= 1
                                 && getUserRate() <= 5
                                 && (isNullOrEmpty('userOpinion') || getLength('userOpinion') <= 1000)
                                 && getUserTicket().isExpired
                                 && getUserTicket().eventEndDateTime < request.time;
            }

            match /rewards/{rewardId} {
                allow read: if isAuthenticated();
                allow create: if isPartner()
                                 && isPartnerFromClub(clubId)
                                 && isNonNegativeNumber('requiredEntries')
                                 && isNotEmptyString('description');
                allow delete: if isPartner()
                                 && isPartnerFromClub(clubId);
            }

            match /selectors/{selectorId} {
                allow read: if isPartner() && isPartnerFromClub(clubId) || isSelector() && isRequestFromCurrentAccount(selectorId);
                allow delete: if isPartner() && isPartnerFromClub(clubId);
            }
        }

        match /clubsSales/{clubId} {
            allow read: if isPartner() && isPartnerFromClub(clubId);
        }

        match /currencyParams/{currency} {
            allow read: if isAuthenticated();
        }

        match /events/{eventId} {
            function isValidEvent() {
                return isValidArtistName();
            }

            function isValidConcertInfo() {
                return !isConcert() || isConcert() && isValidArtistName();
            }

            function isValidArtistName() {
                return isConcert() && isNotEmptyString('artistName')
                       && getLength('artistName') <= 100;
            }

            function getArtistName() {
                return request.resource.data.artistName;
            }

            function isConcert() {
                return request.resource.data.isConcert;
            }


            allow read: if isAuthenticated();
            allow write: if isPartner() && isValidEvent() && isPartnerFromClub(request.resource.data.clubId);
        }

        match /partners/{partnerId} {
            allow read: if isPartner() && isRequestFromCurrentAccount(partnerId);
        }

        match /partnersAccessCodes/{code} {
            allow read: if true;
        }

        match /partnersDiscounts/{discountId} {
            allow read: if isPartner();
        }

        match /reviewReports/{reportId} {
            allow read: if isAuthenticated();
            allow create: if isAuthenticated() && isRequestFromCurrentAccount(request.resource.data.reporterId);
        }

        match /selectors/{selectorId} {
            allow read: if isSelector() && isRequestFromCurrentAccount(selectorId);
        }

        match /selectorsAccessCodes/{code} {
            allow read: if true;
            allow create: if isPartner() && isPartnerFromClub(request.resource.data.clubId);
        }

        match /stripeCustomers/{customerId} {
            allow read, update: if isAuthenticated() && isRequestFromCurrentAccount(customerId);
        }

        match /ticketPaymentSessions/{sessionId} {
            allow read, write: if false;
        }

        match /updateClubSalesTasks/{eventId} {
            allow read, write: if false;
        }

        match /users/{userId} {
            allow read: if isUser() && isRequestFromCurrentAccount(userId)
                           || isSelector();
            allow update: if (isUser()
                              && isRequestFromCurrentAccount(userId)
                              && request.resource.data.attendance == resource.data.attendance)
                             || isSelector();

            match /promotionCodes/{code} {
                allow read: if isUser() && isRequestFromCurrentAccount(userId);
            }

            match /tickets/{ticketId} {
                allow read: if isUser() && isRequestFromCurrentAccount(userId)
                               || isSelector();
                allow update: if isSelector() && getSelector().data.clubId == resource.data.clubId;
            }
        }

        match /vipPaymentSessions/{sessionId} {
            allow read, write: if false;
        }
    }
}
