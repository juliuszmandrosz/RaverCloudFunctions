rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        function isAuthenticated() {
            return request.auth != null;
        }

        function isUser() {
            return isAuthenticated() && hasUserClaim();
        }

        function isPartner() {
            return isAuthenticated() && hasPartnerClaim();
        }

        function isSelector() {
            return isAuthenticated() && hasSelectorClaim();
        }

        function hasUserClaim() {
            return 'isUser' in request.auth.token && request.auth.token.isUser == true;
        }


        function hasPartnerClaim() {
            return 'isPartner' in request.auth.token && request.auth.token.isPartner == true;
        }

        function hasSelectorClaim() {
            return 'isSelector' in request.auth.token && request.auth.token.isSelector == true;
        }

        function getUser() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid));
        }

        function getPartner() {
            return get(/databases/$(database)/documents/partners/$(request.auth.uid));
        }

        function getSelector() {
            return get(/databases/$(database)/documents/selectors/$(request.auth.uid));
        }

        function isPartnerFromClub(clubId) {
            return clubId == getPartner().data.clubId;
        }

        function isSelectorFromClub(clubId) {
            return clubId == getSelector().data.clubId;
        }

        function isRequestFromCurrentAccount(accountId) {
            return request.auth.uid == accountId;
        }

        function isNullOrEmpty(fieldName) {
            return !(fieldName in request.resource.data) || getLength(fieldName) == 0;
        }

        function isNotEmptyString(fieldName) {
            return request.resource.data[fieldName] is string && getLength(fieldName) > 0;
        }

        function isNonNegativeNumber(fieldName) {
            return request.resource.data[fieldName] is number && request.resource.data[fieldName] >= 0;
        }

        function getLength(fieldName) {
            return request.resource.data[fieldName].size();
        }

        function checkIfOnlyOneFieldHasChanged(fieldName) {
            return request.resource.data.diff(resource.data).affectedKeys().hasOnly([fieldName]);
        }

        function checkIfFieldHasNotChanged(fieldName) {
            return !(fieldName in resource.data) || !request.resource.data.diff(resource.data).affectedKeys().hasAny([fieldName]);
        }

        function checkIfRequestContainsField(fieldName) {
            return fieldName in request.resource.data;
        }

        function verifyFields(item, required, optional) {
            let allAllowedFields = required.concat(optional);
            return item.keys().hasAll(required) && item.keys().hasOnly(allAllowedFields);
        }

        match /availableFilters/{filters} {
            allow read: if isAuthenticated();
            allow write: if false;
        }

        match /clubs/{clubId} {
            allow read: if isAuthenticated();

            match /appliedDiscounts/{discountId} {
                allow read, create: if isPartner() && isPartnerFromClub(clubId);
            }

            match /eventCosts/{eventId} {
                allow read, create: if isPartner() && isPartnerFromClub(clubId);
            }

            match /eventReview/{eventId} {
                allow read, create: if isPartner() && isPartnerFromClub(clubId);
            }

            match /eventTickets/{eventId} {
                function getTicketPools() {
                    return request.resource.data.ticketPools;
                }

                function getTicketSales() {
                    return request.resource.data.ticketSales;
                }

                function checkIfTicketPoolsAreValid() {
                    return getTicketPools().size() >= 1
                           && getTicketPools().size() <= 5
                           && isTicketPoolValid(getTicketPools()[0])
                           && (getTicketPools().size() < 2 || isTicketPoolValid(getTicketPools()[1]))
                           && (getTicketPools().size() < 3 || isTicketPoolValid(getTicketPools()[2]))
                           && (getTicketPools().size() < 4 || isTicketPoolValid(getTicketPools()[3]))
                           && (getTicketPools().size() < 5 || isTicketPoolValid(getTicketPools()[4]));
                }

                function checkIfTicketSalesAreValid() {
                    return checkIfTicketSalesFieldsAreValid(getTicketSales())
                           && isEventFeeValid(getTicketSales());
                }

                function isTicketPoolValid(pool) {
                    return checkIfTicketPoolFieldsAreValid(pool)
                           && isTicketQuantityValid(pool)
                           && isTicketPriceValid(pool)
                           && isVipPriceValid(pool);
                }

                function checkIfTicketPoolFieldsAreValid(pool) {
                    return pool.currency is string
                           && pool.isCurrent is bool
                           && pool.isSoldOut is bool
                           && pool.isVipEnabled is bool
                           && pool.poolNumber is int
                           && pool.ticketPrice is int
                           && pool.ticketQuantity is int
                           && pool.ticketsSold is int
                           && (pool.ticketsSold == null || pool.ticketsSold is int);
                }

                function checkIfTicketSalesFieldsAreValid(sales) {
                    return sales.currency is string
                           && sales.eventFee is float
                           && sales.isExclusiveEvent is bool
                           && sales.clubIncome is number && sales.clubIncome == 0
                           && sales.ticketsSold is number && sales.ticketsSold == 0
                           && sales.totalRevenue is number && sales.totalRevenue == 0
                           && sales.vipsSold is number && sales.vipsSold == 0;
                }

                function getMinTicketPrice(pool) {
                    return get(/databases/$(database)/documents/currencyParams/$(pool.currency)).data.minTicketPrice;
                }

                function getMaxTicketPrice(pool) {
                    return get(/databases/$(database)/documents/currencyParams/$(pool.currency)).data.maxTicketPrice;
                }

                function isTicketQuantityValid(pool) {
                    return pool.ticketQuantity >= 1 && pool.ticketQuantity <= 100000;
                }

                function isTicketPriceValid(pool) {
                    return pool.ticketPrice >= getMinTicketPrice(pool) && pool.ticketPrice <= getMaxTicketPrice(pool);
                }

                function isVipPriceValid(pool) {
                    return !pool.isVipEnabled || pool.vipPrice >= getMinTicketPrice(pool) && pool.vipPrice <= getMaxTicketPrice(pool);
                }

                function isEventFeeValid(sales) {
                    return sales.isExclusiveEvent || !sales.isExclusiveEvent && sales.eventFee == 0.08;
                }


                allow read: if isAuthenticated();
                allow create: if isPartner()
                                 && isPartnerFromClub(clubId)
                                 && checkIfTicketPoolsAreValid()
                                 && checkIfTicketSalesAreValid();
                allow update: if isPartner()
                                 && isPartnerFromClub(clubId)
                                 && checkIfFieldHasNotChanged('ticketSales')
                                 && checkIfTicketPoolsAreValid();

            }

            match /reviews/{reviewId} {
                function getUserRate() {
                    return request.resource.data.userRate;
                }

                function getUserTicket() {
                    return get(/databases/$(database)/documents/users/$(request.auth.uid)/tickets/$(request.resource.data.ticketId)).data;
                }


                allow read: if isAuthenticated();
                allow create: if isUser()
                                 && getUserRate() >= 1
                                 && getUserRate() <= 5
                                 && (isNullOrEmpty('userOpinion') || getLength('userOpinion') <= 1000)
                                 && getUserTicket().isExpired
                                 && getUserTicket().eventEndDateTime < request.time;
            }

            match /rewards/{rewardId} {
                allow read: if isAuthenticated();
                allow create: if isPartner()
                                 && isPartnerFromClub(clubId)
                                 && isNonNegativeNumber('requiredEntries')
                                 && isNotEmptyString('description')
                                 && getLength('description') <= 1000;
                allow delete: if isPartner()
                                 && isPartnerFromClub(clubId);
            }

            match /selectors/{selectorId} {
                allow read: if isPartner() && isPartnerFromClub(clubId) || isSelector() && isRequestFromCurrentAccount(selectorId);
                allow delete: if isPartner() && isPartnerFromClub(clubId);
            }
        }

        match /clubsSales/{clubId} {
            allow read: if isPartner() && isPartnerFromClub(clubId);
        }

        match /currencyParams/{currency} {
            allow read: if isAuthenticated();
        }

        match /events/{eventId} {
            function isValidEvent() {
                return isValidConcertInfo();
            }

            function isValidConcertInfo() {
                return !isConcert() || isConcert() && isValidArtistName();
            }

            function getArtistName() {
                return request.resource.data.artistName;
            }

            function isConcert() {
                return request.resource.data.isConcert;
            }

            function isValidArtistName() {
                return isNotEmptyString('artistName') && getLength('artistName') <= 100;
            }


            allow read: if isAuthenticated();
            allow create, update: if isPartner() && isPartnerFromClub(request.resource.data.clubId);
        }

        match /partners/{partnerId} {
            allow read: if isPartner() && isRequestFromCurrentAccount(partnerId);
        }

        match /partnersAccessCodes/{code} {
            allow read: if true;
        }

        match /partnersDiscounts/{discountId} {
            allow read: if isPartner();
        }

        match /reviewReports/{reportId} {
            allow read: if isAuthenticated();
            allow create: if isAuthenticated() && isRequestFromCurrentAccount(request.resource.data.reporterId);
        }

        match /selectors/{selectorId} {
            allow read: if isSelector() && isRequestFromCurrentAccount(selectorId);
        }

        match /selectorsAccessCodes/{code} {
            allow read: if true;
        }

        match /stripeCustomers/{customerId} {
            allow read, update: if isAuthenticated() && isRequestFromCurrentAccount(customerId);
        }

        match /ticketPaymentSessions/{sessionId} {
            allow read, write: if false;
        }

        match /updateClubSalesTasks/{eventId} {
            allow read, write: if false;
        }

        match /users/{userId} {
            function isUsernameValid() {
                return !checkIfRequestContainsField('username')
                       || (getLength('username') >= 3 && getLength('username') <= 20);
            }

            allow get: if isUser() && isRequestFromCurrentAccount(userId)
                          || isSelector();
            allow list: if isUser();
            allow update: if (isUser()
                              && isRequestFromCurrentAccount(userId)
                              && checkIfFieldHasNotChanged('attendance')
                              && isUsernameValid())
                             || isSelector() && checkIfOnlyOneFieldHasChanged('attendance');

            match /promotionCodes/{code} {
                allow read: if isUser() && isRequestFromCurrentAccount(userId);
            }

            match /tickets/{ticketId} {
                allow read: if isUser() && isRequestFromCurrentAccount(userId)
                               || isSelector();
                allow update: if isSelector() && getSelector().data.clubId == resource.data.clubId
                                 && checkIfOnlyOneFieldHasChanged('isExpired')
                                 && request.resource.data.isExpired && !resource.data.isExpired
                                 || isUser() && isRequestFromCurrentAccount(userId)
                                    && checkIfOnlyOneFieldHasChanged('reviewId');
            }
        }

        match /vipPaymentSessions/{sessionId} {
            allow read, write: if false;
        }
    }
}
